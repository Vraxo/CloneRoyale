{
  "name": "clone-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/generate-service-worker.mjs && vite build --config vite.server.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.mjs",
    "start:server": "node server/index.mjs",
    "test:multiplayer": "node scripts/multiplayer-smoke-test.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
