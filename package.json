{
  "name": "clone-royale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/generate-service-worker.mjs && vite build --config config/vite/server.config.ts && vite build --config config/vite/simulation.config.ts && vite build --config config/vite/services.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node dist-server/index.js",
    "start:server": "node dist-server/index.js",
    "test:multiplayer": "node scripts/multiplayer-smoke-test.mjs",
    "test:offline": "node scripts/offline-smoke-test.mjs",
    "test:replay": "node scripts/replay-smoke-test.mjs",
    "test:replay-archive": "node scripts/replay-archive-smoke-test.mjs",
    "test:server-services": "node scripts/server-services-smoke-test.mjs",
    "test:accounts": "node scripts/accounts-smoke-test.mjs",
    "test:auth-api": "node scripts/auth-api-smoke-test.mjs",
    "test:unit": "tsc -p tsconfig.tests.json && node scripts/run-unit-tests.mjs",
    "test:unit:coverage": "tsc -p tsconfig.tests.json && node scripts/run-unit-tests.mjs --coverage"
  },
  "dependencies": {
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "@types/node": "^20.19.43"
  }
}
